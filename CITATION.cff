    given-names: Aniruddh
repository-code: "https://github.com/aniruddh-jammoria/eval-dual-GPU"
url: "https://aniruddh-jammoria.github.io/eval-dual-GPU/"
keywords:
  - LLM inference
  - benchmark
  - multi-GPU
  - tensor parallelism
  - PCIe
  - llama.cpp
version: 0.2.0
date-released: "2026-09-27"
